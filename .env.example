# Postgres
POSTGRES_USER=vol
POSTGRES_PASSWORD=vol
POSTGRES_DB=vol_gui
DATABASE_URL=postgresql+psycopg://vol:vol@postgres:5432/vol_gui

# Redis
REDIS_URL=redis://redis:6379/0

# Backend / worker
STORAGE_ROOT=/data
VOLATILITY3_OFFLINE=false

# Frontend build arg (baked in at `docker compose build` time, not runtime).
# Leave empty (default) so the built app calls same-origin relative paths
# (/api/...), which nginx proxies to the backend - works behind any
# hostname/port without a rebuild. Only set this if serving the frontend from
# a different origin than the API.
VITE_API_BASE_URL=
